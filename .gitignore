# ============================================================
# 科任教师工作台 — .gitignore
# 仅忽略「运行期产物」与「本地环境数据」，源码与部署脚本始终纳入版本控制。
# ============================================================

# --- 本地 IDE / 项目工作数据（非源码，不入库） ---
.workbuddy/

# --- 运行时数据库（SQLite，含 WAL / 共享内存 / 备份） ---
server/data/
*.db
*.db-wal
*.db-shm
*.sqlite
*.sqlite3

# --- 各类临时备份文件 ---
*.bak-*
*.bak
*-bak

# --- 依赖与构建产物（本项目零外部依赖，正常无这些目录） ---
node_modules/
dist/
build/
out/

# --- 环境变量 / 密钥（若后续引入） ---
.env
.env.*
*.local

# --- 日志 ---
*.log
logs/

# --- 操作系统 / 编辑器临时文件 ---
.DS_Store
Thumbs.db
desktop.ini
*.swp
*~
\#*\#
